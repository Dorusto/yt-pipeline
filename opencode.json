{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "sort": "throughput"
            }
          }
        }
      }
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/media/**": "allow"
    },
    "doom_loop": "deny"
  },
  "agent": {
    "explore": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    },
    "general": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash"
    }
  }
}
