{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openrouter": {
      "models": {
        "xiaomi/mimo-v2.6-pro": {},
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "sort": "throughput"
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "options": {
            "provider": {
              "allow_fallbacks": true,
              "sort": "throughput"
            }
          }
        }
      }
    }
  },
  "permission": {
    "webfetch": "allow",
    "websearch": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/**": "allow",
      "~/media/**": "allow",
      "/root/media/**": "allow",
      "/root/projects/yt-pipeline/**": "allow",
      "/root/.cache/yt-pipeline/**": "allow"
    },
    "doom_loop": "ask"
  }
}
