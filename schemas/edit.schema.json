{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dorusto/yt-pipeline/schemas/edit.schema.json",
  "title": "edit",
  "description": "The edit list: the single source of truth for one edit. Written by the director and read by every output adapter (ffmpeg render, browser preview, graphics engine, optional Kdenlive export). Video slots carry source, in/out, score and reason; audio carries music, SFX, ambience and levels; captions and graphics overlays carry a template and its props.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "brief",
    "sources",
    "video"
  ],
  "additionalProperties": false,
  "$defs": {
    "slot_id": {
      "type": "string",
      "minLength": 1
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "0..1, higher is better"
    },
    "transition": {
      "type": "object",
      "required": [
        "type",
        "duration_s"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "crossfade"
          ]
        },
        "duration_s": {
          "type": "number",
          "minimum": 0,
          "description": "blend length in seconds; 0 for cut"
        }
      }
    },
    "video_slot": {
      "type": "object",
      "required": [
        "id",
        "clip",
        "in_s",
        "out_s",
        "score",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slot_id"
        },
        "clip": {
          "type": "string",
          "minLength": 1,
          "description": "file name of the source clip, matched against sources[].file"
        },
        "in_s": {
          "$ref": "#/$defs/seconds"
        },
        "out_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "must be greater than in_s; the writer asserts it"
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "why the director picked this window, in plain words"
        },
        "transition": {
          "$ref": "#/$defs/transition",
          "description": "transition INTO this slot; ignored on the first slot"
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1.0,
          "description": "playback rate of the slot; 1.0 is real time"
        },
        "middle_speed": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 1.25,
          "default": 1.0,
          "description": "speed ramp of a camera-move slot: the middle half of the source window (in_s..out_s) plays at this rate, the first and last quarters at real time; on-screen length is 0.25L + 0.5L/middle_speed + 0.25L for a source window of L seconds; 1.0 (the default) is no ramp"
        },
        "peak_s": {
          "type": "number",
          "minimum": 0,
          "description": "the best moment of the shot in the source clip, in seconds: the vision model's peak_s, else the second of maximum scene activity, else the middle of the candidate window; a trimmed cut is centred on it"
        },
        "peak_source": {
          "type": "string",
          "enum": [
            "vision",
            "motion",
            "middle"
          ],
          "description": "where peak_s came from"
        },
        "centred": {
          "type": "boolean",
          "description": "true when the cut was trimmed out of a longer candidate window and holds peak_s"
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "move",
            "hold",
            "transition_in",
            "transition_out",
            "setup",
            "teardown",
            "accidental",
            null
          ],
          "description": "quality role the window came from, context only"
        },
        "motion_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "camera motion label of the window, context only"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "vision-model description of the window; null when no model was used"
        },
        "kind": {
          "type": "string",
          "const": "video",
          "default": "video",
          "description": "slot kind discriminator; omitted on legacy video slots"
        },
        "shot_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "short candidate id in the shotlog, e.g. 0071/s2; the id feedback and explain.html refer to"
        },
        "beat_grid": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "downbeat",
            "half_bar",
            "beat",
            null
          ],
          "description": "which beat grid the cut at this slot's end used: a downbeat, a half-bar beat (keeps the bar count even), or the nearest beat; null when the cut was not snapped"
        }
      }
    },
    "audio_source": {
      "type": "object",
      "required": [
        "path"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "gain_db": {
          "type": "number",
          "default": 0
        },
        "fade_in_s": {
          "type": "number",
          "minimum": 0
        },
        "fade_out_s": {
          "type": "number",
          "minimum": 0
        },
        "start_s": {
          "type": "number",
          "minimum": 0,
          "description": "position on the edit timeline where this source starts"
        }
      }
    },
    "overlay": {
      "type": "object",
      "required": [
        "template",
        "props"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/slot_id"
        },
        "template": {
          "type": "string",
          "minLength": 1,
          "description": "named template rendered by the captions or graphics engine"
        },
        "props": {
          "type": "object",
          "description": "template properties; the template defines what it reads"
        },
        "start_s": {
          "$ref": "#/$defs/seconds"
        },
        "end_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "slot": {
          "type": [
            "string",
            "null"
          ],
          "description": "video slot id this overlay is bound to; null when it uses start_s/end_s"
        }
      }
    },
    "ken_burns": {
      "type": "object",
      "required": [
        "move",
        "amount",
        "focus_x",
        "focus_y"
      ],
      "additionalProperties": false,
      "description": "slow move over a still photo during its slot",
      "properties": {
        "move": {
          "type": "string",
          "enum": [
            "zoom_in",
            "zoom_out",
            "pan_left",
            "pan_right"
          ],
          "description": "chosen deterministically from subject_position: centre box -> zoom_in on the subject; else pan toward the subject; zoom_out only for close-ups"
        },
        "amount": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.5,
          "description": "zoom ratio delta or pan travel as a fraction of the frame (default 0.08)"
        },
        "focus_x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ken Burns focus, usually the subject centre x"
        },
        "focus_y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ken Burns focus, usually the subject centre y"
        }
      }
    },
    "photo_slot": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "photo",
        "duration_s",
        "ken_burns",
        "score",
        "reason"
      ],
      "additionalProperties": false,
      "description": "a still photo on the timeline: held 2-4 s with a Ken Burns move",
      "properties": {
        "id": {
          "$ref": "#/$defs/slot_id"
        },
        "kind": {
          "type": "string",
          "const": "photo"
        },
        "photo": {
          "type": "string",
          "minLength": 1,
          "description": "file name of the source photo, matched against sources[].file"
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 4,
          "description": "how long the photo is on screen (2..4 s)"
        },
        "ken_burns": {
          "$ref": "#/$defs/ken_burns"
        },
        "score": {
          "$ref": "#/$defs/score"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "why the director picked this photo, in plain words"
        },
        "transition": {
          "$ref": "#/$defs/transition",
          "description": "transition INTO this slot; ignored on the first slot"
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "description": "vision-model description of the photo; null when no model was used"
        },
        "capture_time": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 8601 EXIF capture time of the photo"
        },
        "shot_key": {
          "type": [
            "string",
            "null"
          ],
          "description": "short candidate id in the shotlog, e.g. 0072/p1; the id feedback and explain.html refer to"
        },
        "beat_grid": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "downbeat",
            "half_bar",
            "beat",
            null
          ],
          "description": "which beat grid the cut at this slot's end used: a downbeat, a half-bar beat (keeps the bar count even), or the nearest beat; null when the cut was not snapped"
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "status",
        "reason"
      ],
      "additionalProperties": false,
      "description": "one candidate the director considered: used in the edit or rejected, with the reason in plain words",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "short candidate id, e.g. 0071/s2"
        },
        "status": {
          "type": "string",
          "enum": [
            "used",
            "rejected"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "why it was used or rejected: near-duplicate of X, defect, setup/teardown, low score, did not fit the length"
        },
        "slot": {
          "type": [
            "string",
            "null"
          ],
          "description": "edit slot id when used, e.g. v3 or p1"
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "description": "shotlog score of the candidate when known"
        },
        "clip": {
          "type": [
            "string",
            "null"
          ],
          "description": "source file name of the candidate"
        },
        "window_in_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "candidate window start in the source, seconds"
        },
        "window_out_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "candidate window end in the source, seconds"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the write"
    },
    "tool": {
      "type": "string",
      "description": "tool that wrote the file, e.g. scripts/director.py"
    },
    "brief": {
      "type": "object",
      "required": [
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "text": {
          "type": "string",
          "description": "the brief in plain language"
        },
        "target_duration_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "order": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "chronological",
            "score",
            null
          ]
        },
        "pacing": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "calm-to-energy",
            "uniform",
            null
          ]
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "clips the video slots cut from; original files are read-only",
      "items": {
        "type": "object",
        "required": [
          "file",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "description": "absolute path of the clip, proxy or original"
          },
          "duration_s": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "media_type": {
            "type": "string",
            "enum": [
              "video",
              "photo"
            ],
            "default": "video"
          }
        },
        "description": "clips and photos the slots cut from; original files are read-only"
      }
    },
    "video": {
      "type": "array",
      "minItems": 1,
      "description": "video and photo slots in timeline order; photo slots hold a still 2-4 s with a Ken Burns move",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/video_slot"
          },
          {
            "$ref": "#/$defs/photo_slot"
          }
        ],
        "description": "video and photo slots in timeline order"
      }
    },
    "audio": {
      "type": "object",
      "description": "audio plan: ambience from the slots or a file, optional music and SFX, output levels",
      "additionalProperties": false,
      "properties": {
        "ambience": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "gain_db": {
              "type": "number",
              "default": 0
            },
            "source": {
              "type": "string",
              "enum": [
                "slot",
                "file"
              ],
              "description": "slot: each slot's own ambient audio; file: one ambience file for the whole edit"
            },
            "file": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "music": {
          "anyOf": [
            {
              "$ref": "#/$defs/audio_source"
            },
            {
              "type": "null"
            }
          ]
        },
        "ambient_under_music_db": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "default": 12,
          "description": "how far the cleaned ambient bus sits under the music, in dB; it stays audible, never removed"
        },
        "sfx": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/audio_source"
          }
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target_lufs": {
              "type": [
                "number",
                "null"
              ]
            },
            "true_peak_db": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    },
    "captions": {
      "type": "array",
      "description": "caption overlays; empty when the edit has none",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "decisions": {
      "type": "array",
      "description": "every candidate the director considered, used or rejected, with the reason; the source explain.html renders",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "graphics": {
      "type": "array",
      "description": "graphics overlays (titles, maps, counters); empty when the edit has none",
      "items": {
        "$ref": "#/$defs/overlay"
      }
    },
    "meta": {
      "type": "object",
      "description": "run metadata; every tool reports wall time and LLM cost",
      "additionalProperties": false,
      "properties": {
        "tool": {
          "type": "string"
        },
        "wall_time_s": {
          "type": "number",
          "minimum": 0
        },
        "llm_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "speed_ramp": {
          "type": "boolean",
          "description": "true when the optional middle speed ramp was allowed for this edit (default off)"
        },
        "director": {
          "type": "object",
          "additionalProperties": false,
          "description": "who made the edit: the LLM loop (approved or a kept draft) or the rule-based director as its fallback, with plain-word notes",
          "required": [
            "by"
          ],
          "properties": {
            "by": {
              "enum": [
                "llm",
                "rules",
                "agent"
              ]
            },
            "approved": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 20
            },
            "review": {
              "type": "object",
              "additionalProperties": false,
              "description": "the last reviewer verdict: approved plus plain-word objections, each naming the slot id and its 1-based position in the edit",
              "required": [
                "approved",
                "objections"
              ],
              "properties": {
                "approved": {
                  "type": "boolean"
                },
                "objections": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "slot",
                      "shot",
                      "text"
                    ],
                    "properties": {
                      "slot": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "shot": {
                        "type": [
                          "integer",
                          "null"
                        ],
                        "minimum": 1
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
