{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dorusto/yt-pipeline/schemas/fragments.schema.json",
  "title": "fragments",
  "description": "Edit decision list consumed by kdenlive_from_fragments.py and srt_from_fragments.py. Extra fields (score, reason, slot) written by the AI Director are allowed and ignored by the generators.",
  "type": "object",
  "required": ["fragments"],
  "properties": {
    "source_dir": {
      "type": "string",
      "description": "folder containing the source clips, used by kdenlive_from_fragments.py"
    },
    "output": {
      "type": "string",
      "description": "path of the .kdenlive project to write"
    },
    "fragments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "in", "out"],
        "properties": {
          "file": {"type": "string", "minLength": 1},
          "in": {"type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"},
          "out": {"type": "string", "pattern": "^\\d{2}:\\d{2}:\\d{2}\\.\\d{3}$"},
          "label": {"type": "string"},
          "score": {"type": "number"},
          "reason": {"type": "string"},
          "slot": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}