{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dorusto/yt-pipeline/schemas/shotlog.schema.json",
  "title": "shotlog",
  "description": "One shotlog per project workspace, written by scripts/index.py: every quality segment as a scored candidate with hook and reason \u2014 one candidate per content beat when describe split a long segment into beats \u2014 the effective labels (the vision verdict wins on uncertain segments) and the similar-segment links the director uses for diversity. Score = weighted fusion of the vision content score and the label score; audio and text components join at D2/D4 with zero weight until then. Overlapping shots keep the higher score, the other is marked suppressed_by.",
  "type": "object",
  "required": [
    "generated_at",
    "weights",
    "shots"
  ],
  "$defs": {
    "segment_ref": {
      "type": "string",
      "minLength": 3,
      "description": "shot key: <clip counter>/<segment id>, or <clip counter>/<segment id><beat id> for a content beat, e.g. 0081/s7 or 0072/s7b1"
    },
    "role": {
      "type": "string",
      "enum": [
        "move",
        "hold",
        "transition_in",
        "transition_out",
        "setup",
        "teardown",
        "accidental"
      ]
    },
    "motion_label": {
      "type": "string",
      "enum": [
        "static",
        "minor_motion",
        "pan_left",
        "pan_right",
        "tilt_up",
        "tilt_down",
        "roll_cw",
        "roll_ccw",
        "dolly_in",
        "dolly_out",
        "zoom_in",
        "zoom_out",
        "truck_left",
        "truck_right",
        "pedestal_up",
        "pedestal_down",
        "complex_motion",
        "travel_forward",
        "travel_backward",
        "orbit_candidate",
        "orbit",
        "tracking",
        "reveal",
        "pov"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "geometry",
        "verdict"
      ],
      "description": "geometry = the motion/quality label; verdict = the vision model's adjudication, which wins on uncertain segments"
    }
  },
  "properties": {
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the run"
    },
    "workspace": {
      "type": "string",
      "description": "workspace the shotlog was built from"
    },
    "weights": {
      "type": "object",
      "required": [
        "vision",
        "labels"
      ],
      "description": "fusion weights used for the score; audio_energy and text are reserved for D2/D4 and stay 0 until their tools exist",
      "properties": {
        "vision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "labels": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "audio_energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "text": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "description": "one entry per quality segment, in clip order then time order",
      "items": {
        "type": "object",
        "required": [
          "key",
          "clip",
          "segment_id",
          "start_s",
          "end_s",
          "eligible",
          "role",
          "role_source",
          "motion_label",
          "label_source",
          "score",
          "scores",
          "hook",
          "reason"
        ],
        "properties": {
          "key": {
            "$ref": "#/$defs/segment_ref"
          },
          "clip": {
            "type": "string",
            "minLength": 1
          },
          "segment_id": {
            "type": "string",
            "minLength": 1
          },
          "beat_of": {
            "type": [
              "string",
              "null"
            ],
            "description": "parent quality segment id when this shot is a content beat of a long segment; null otherwise"
          },
          "beat_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "beat id inside the parent segment (b1..bN) when this shot is a content beat"
          },
          "beat_label": {
            "type": [
              "string",
              "null"
            ],
            "description": "what this beat is: approach, inside, exit, enter, leave, ..."
          },
          "start_s": {
            "type": "number",
            "minimum": 0
          },
          "end_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "eligible": {
            "type": "boolean",
            "description": "false for confident accidental/setup/teardown and for suppressed shots; the director only picks eligible shots"
          },
          "role": {
            "$ref": "#/$defs/role"
          },
          "role_source": {
            "$ref": "#/$defs/source"
          },
          "motion_label": {
            "$ref": "#/$defs/motion_label"
          },
          "label_source": {
            "$ref": "#/$defs/source"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1,
            "description": "confidence of the effective label (verdict confidence when the verdict won)"
          },
          "uncertain": {
            "type": "boolean"
          },
          "uncertain_reasons": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "scenery": {
            "type": [
              "string",
              "null"
            ]
          },
          "semantic_motion": {
            "type": [
              "string",
              "null"
            ]
          },
          "interest": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 100
          },
          "hero": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "fused score, the number the director ranks by"
          },
          "scores": {
            "type": "object",
            "required": [
              "labels"
            ],
            "properties": {
              "vision": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "labels": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "audio_energy": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "text": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": true
          },
          "hook": {
            "type": "string",
            "description": "short phrase naming the shot's draw, for the review UI and later metadata"
          },
          "reason": {
            "type": "string",
            "description": "why the shot scored what it did, in plain words"
          },
          "similar_to": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/segment_ref"
            },
            "description": "shots the similarity tool found visually close (cosine >= threshold)"
          },
          "defects": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "measured defect names carried from quality"
          },
          "suppressed_by": {
            "oneOf": [
              {
                "$ref": "#/$defs/segment_ref"
              },
              {
                "type": "null"
              }
            ],
            "description": "key of the higher-scoring shot that overlaps this one by more than 50%; null when not suppressed"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200,
            "description": "one-line summary in at most 12 words from describe; null when the shot has no vision"
          },
          "tags": {
            "type": "array",
            "maxItems": 8,
            "description": "short tag list from describe; empty when the shot has no vision",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "media_type": {
            "type": "string",
            "enum": [
              "video",
              "photo"
            ],
            "default": "video",
            "description": "photo shots come from stills (JPEG/HEIC) ingested next to the clips"
          },
          "capture_time": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO 8601 capture time of the photo from EXIF; null for video shots"
          },
          "subject_position": {
            "type": [
              "object",
              "null"
            ],
            "description": "main subject centre in normalised image coordinates (photos only)",
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    },
    "wall_time_s": {
      "type": "number",
      "minimum": 0
    },
    "llm_cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "always 0: this tool calls no model service"
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
