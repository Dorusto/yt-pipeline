{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Dorusto/yt-pipeline/schemas/describe.schema.json",
  "title": "describe",
  "description": "Vision descriptions written by scripts/describe.py per clip: one entry per quality segment, three frames in order with timestamps and the motion label sent to the VisionModel. Confident accidental/setup/teardown segments are skipped (no model call). Every uncertain segment carries a verdict from the model whose label wins in the shotlog. Frames are never written to disk — only their timestamps.",
  "type": "object",
  "required": ["file", "duration_s", "model", "segments"],
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "move",
        "hold",
        "transition_in",
        "transition_out",
        "setup",
        "teardown",
        "accidental"
      ]
    },
    "motion_label": {
      "type": "string",
      "enum": [
        "static",
        "minor_motion",
        "pan_left",
        "pan_right",
        "tilt_up",
        "tilt_down",
        "roll_cw",
        "roll_ccw",
        "dolly_in",
        "dolly_out",
        "zoom_in",
        "zoom_out",
        "truck_left",
        "truck_right",
        "pedestal_up",
        "pedestal_down",
        "complex_motion",
        "travel_forward",
        "travel_backward",
        "orbit_candidate",
        "orbit",
        "tracking",
        "reveal",
        "pov"
      ],
      "description": "CameraBench geometric vocabulary plus the semantic moves the vision step may name in a verdict (orbit, tracking, reveal, pov)"
    },
    "uncertain_reason": {
      "type": "string",
      "enum": [
        "scale_vs_radial_flow",
        "parallax_vs_rotation",
        "self_moving_regions",
        "mixed_motion_signals",
        "role_signals_disagree",
        "motion_uncertain"
      ],
      "description": "echoed from the quality segment; the reasons the geometry could not commit"
    },
    "semantic_motion": {
      "type": "string",
      "enum": ["orbit", "tracking", "reveal", "travel", "none"],
      "description": "semantic camera move read from the frames; travel covers travel_forward/travel_backward, none when no semantic move applies"
    },
    "verdict": {
      "type": "object",
      "description": "the model's adjudication of an uncertain segment; its role and motion_label win in the shotlog",
      "required": ["role", "motion_label", "confidence", "note"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "motion_label": {"$ref": "#/$defs/motion_label"},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "the model's confidence in its own verdict"
        },
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "frame": {
      "type": "object",
      "required": ["t_s"],
      "properties": {
        "t_s": {
          "type": "number",
          "minimum": 0,
          "description": "timestamp of the sampled frame inside the source clip, in seconds, in time order"
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "file": {
      "type": "string",
      "minLength": 1,
      "description": "clip file name"
    },
    "path": {
      "type": "string",
      "description": "absolute path of the analysed clip"
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of the describe run"
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "vision model id that produced the descriptions"
    },
    "llm_cost_usd": {
      "type": "number",
      "minimum": 0,
      "description": "sum of the per-segment costs of this run"
    },
    "wall_time_s": {
      "type": "number",
      "minimum": 0
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "description": "one entry per quality segment, in time order; described segments carry the model output, skipped ones only the reason",
      "items": {
        "type": "object",
        "required": [
          "id",
          "start_s",
          "end_s",
          "status",
          "role",
          "motion_label",
          "uncertain",
          "uncertain_reasons"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "start_s": {"type": "number", "minimum": 0},
          "end_s": {"type": "number", "exclusiveMinimum": 0},
          "status": {
            "type": "string",
            "enum": ["described", "skipped"],
            "description": "described = the model saw the frames; skipped = no call was made"
          },
          "role": {"$ref": "#/$defs/role"},
          "motion_label": {
            "type": ["string", "null"],
            "description": "the geometric label from quality, echoed as the model input"
          },
          "uncertain": {"type": "boolean"},
          "uncertain_reasons": {
            "type": "array",
            "items": {"$ref": "#/$defs/uncertain_reason"}
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {"$ref": "#/$defs/frame"}
          },
          "description": {"type": ["string", "null"]},
          "subject": {"type": ["string", "null"]},
          "scenery": {"type": ["string", "null"]},
          "semantic_motion": {
            "oneOf": [
              {"$ref": "#/$defs/semantic_motion"},
              {"type": "null"}
            ]
          },
          "interest": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 100,
            "description": "how interesting the shot is on its own, 0-100"
          },
          "hero": {
            "type": ["boolean", "null"],
            "description": "true when the segment is a hero shot worth structuring the edit around"
          },
          "verdict": {
            "oneOf": [
              {"$ref": "#/$defs/verdict"},
              {"type": "null"}
            ],
            "description": "required in practice for every uncertain segment; null on confident ones"
          },
          "skip_reason": {
            "type": ["string", "null"],
            "description": "why no model call was made"
          },
          "cost_usd": {
            "type": ["number", "null"],
            "minimum": 0,
            "description": "cost of this segment's call"
          }
        },
        "additionalProperties": true,
        "allOf": [
          {
            "$comment": "described segments carry the model output; skipped ones carry a reason",
            "if": {
              "properties": {"status": {"const": "described"}},
              "required": ["status"]
            },
            "then": {
              "required": [
                "frames",
                "description",
                "subject",
                "scenery",
                "semantic_motion",
                "interest",
                "hero",
                "verdict"
              ]
            },
            "else": {"required": ["skip_reason"]}
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
