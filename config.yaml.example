# AI Director configuration — copy to config.yaml and edit.
# config.yaml is git-ignored; config.yaml.example is the committed template.
# Model ids are OpenRouter slugs (the part after openrouter.ai/models/).

models:
  architect: xiaomi/mimo-v2.6-pro
  coder: deepseek/deepseek-v4.1-flash
  coder_fallback: z-ai/glm-5.3-flash
  director: deepseek/deepseek-v4.1-flash
  vision: z-ai/glm-5.3-flash
  vision_fallback: deepseek/deepseek-v4.1-flash

# Maximum USD one job may spend on OpenRouter calls across processes. The LLM
# client refuses further calls once this is reached. Omit or use null for no limit.
llm_budget_usd: 5.0

# Backend used by scripts/common/llm.py: openrouter or mock.
llm_backend: openrouter

# Optional per-project spend ledger (JSON) so llm_budget_usd caps a whole job
# across separate tool runs. Prefer the workspace copy: <workspace>/llm_spend.json.
# Overridden by the YT_SPEND_LEDGER environment variable; when neither is set,
# YT_WORKSPACE/llm_spend.json is used if YT_WORKSPACE is set.
# spend_ledger: /path/to/workspace/llm_spend.json
